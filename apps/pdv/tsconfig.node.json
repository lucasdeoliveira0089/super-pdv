{
  "extends": "@super-pdv/config/tsconfig/base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.tsc/node",
    "types": ["node", "electron-vite/node"]
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "e2e/**/*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*"
  ]
}
