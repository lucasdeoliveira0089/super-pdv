# Copie para `.env` (neste diretório) para mudar os endereços usados pelo PDV.
# São gravados no build (electron-vite); sem valor, valem os padrões abaixo.

# API central (login, sessão e dados do caixa).
MAIN_VITE_API_URL=http://localhost:3333

# Gestor web: o "Esqueci minha senha" do PDV abre a recuperação de senha dele.
MAIN_VITE_GESTOR_URL=http://localhost:3000
