# Copie para `.env` (neste diretório) para executar a API localmente.
NODE_ENV=development
PORT=3333
# Banco local do docker-compose.yml (pnpm db:up na raiz).
DATABASE_URL=postgres://superpdv:superpdv@localhost:5432/superpdv

# Segredo dos tokens de acesso (>= 32 caracteres). Em produção, gere um valor
# aleatório, por exemplo: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-somente-local-troque-em-producao-0123456789

# Endereços públicos usados nos links de recuperação de senha.
GESTOR_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# E-mail: Mailpit local do docker-compose.yml (caixa de entrada em http://localhost:8025).
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=Super PDV <nao-responda@superpdv.local>
